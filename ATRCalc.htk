/**
 * ATR Calculator
 * Ticker: Quote object
 * Montage1: The name of the Montage Level II window you want to trade off of
 * MainHTF: The name of your chart daily chart you want to fetch the ATR from
 * Disclaimer: Test all hotkeys in replay mode before going live. Creator shall not be liable for losses
 * or any errors or inaccuracies, regardless of cause to the user.
 */
function CalcATR() {
    ExecHotkey("InitTicker");
    
    $chart=GetWindowObj("ChartHTF");
    $chart.DayChart 1d;
    $ticker.data.ATR1 = $chart.GetStudyVal("StudyAvgTrueRange");
    $ticker.data.ATR1Half = $ticker.data.ATR1 * 1.5;
    $ticker.data.ATR2 = $ticker.data.ATR1 * 2;
    
    if($ticker.Open > 0) {
        $tmpPrice=$ticker.Open;
    } else {
        $tmpPrice=$ticker.Ask;
    }

    if($ticker.data.Side == "long") {
        $chart.DrawHorzLineWithPrice($tmpPrice + $ticker.data.ATR1, Color(4,115,218));
        $chart.DrawHorzLineWithPrice($tmpPrice + $ticker.data.ATR1Half, Color(4, 115, 218));
        $chart.DrawHorzLineWithPrice($tmpPrice + $ticker.data.ATR2, Color(4, 115, 218));
    } else {
        $chart.DrawHorzLineWithPrice($tmpPrice - $ticker.data.ATR1, Color(4,115,218));
        $chart.DrawHorzLineWithPrice($tmpPrice - $ticker.data.ATR1Half, Color(4, 115, 218));
        $chart.DrawHorzLineWithPrice($tmpPrice - $ticker.data.ATR2, Color(4, 115, 218));
    }

    DelVar("$CHART","$TMPPRICE");
}
